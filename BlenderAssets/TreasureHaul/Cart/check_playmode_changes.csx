using UnityEngine;
using STYLY.TIB_Template.TreasureHaul;
var counter=UnityEngine.Object.FindFirstObjectByType<CartCargoCounter>();
var a=GameObject.Find("SampleCargo_0").GetComponent<CargoValuable>();
var b=GameObject.Find("SampleCargo_1").GetComponent<CargoValuable>();
var c=GameObject.Find("SampleCargo_2").GetComponent<CargoValuable>();
if(counter.TotalValue.CurrentValue!=2800)throw new System.Exception("Automatic removal failed");
a.SetCurrentValue(1120);counter.RefreshNow();
if(counter.TotalValue.CurrentValue!=2320)throw new System.Exception("Damage failed");
c.SetHeld(true);counter.RefreshNow();
if(counter.TotalValue.CurrentValue!=1120)throw new System.Exception("Held exclusion failed");
a.gameObject.SetActive(false);counter.RefreshNow();
if(counter.TotalValue.CurrentValue!=0)throw new System.Exception("Disable failed");
a.gameObject.SetActive(true);a.SetCurrentValue(1600);c.SetHeld(false);b.transform.position-=Vector3.right*2;
counter.RefreshNow();
if(counter.TotalValue.CurrentValue!=3600)throw new System.Exception("Restore failed");
var display=counter.GetComponentInChildren<TMPro.TMP_Text>();
if(display.text!="3,600 G")throw new System.Exception("Display binding failed");
return "PASS automatic 3600 -> 2800; damage 2320; held 1120; disable 0; restored text 3,600 G";
