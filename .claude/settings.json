{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",

    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(git update-ref:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)",
      "Bash(gh auth token:*)",
      "Bash(gh auth logout:*)",
      "Bash(gh release:*)",

      "Edit(**/*.unity)",
      "Write(**/*.unity)",
      "Edit(**/*.prefab)",
      "Write(**/*.prefab)",
      "Edit(**/*.asset)",
      "Write(**/*.asset)",
      "Edit(**/*.meta)",
      "Write(**/*.meta)",
      "Edit(Library/**)",
      "Write(Library/**)",
      "Edit(Temp/**)",
      "Write(Temp/**)",
      "Edit(UserSettings/**)",
      "Write(UserSettings/**)",

      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.keystore)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)"
    ],

    "ask": [
      "Bash(gh api:*)",
      "Bash(git rebase:*)",
      "Bash(git worktree remove:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(brew:*)",
      "Bash(open:*)",
      "Edit(Packages/manifest.json)",
      "Edit(ProjectSettings/**)",
      "Write(ProjectSettings/**)"
    ],

    "allow": [
      "Bash(npx --yes uloop-cli:*)",
      "Bash(npx uloop-cli:*)",
      "Bash(uloop:*)",
      "Bash(npx --yes uloop-cli@*:*)",
      "Bash(npx uloop-cli@*:*)",
      "Bash(npx --yes uloop-cli@2.2.0:*)",
      "Bash(npx uloop-cli@2.2.0:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git restore:*)",
      "Bash(git mv:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree add:*)",
      "Bash(git -C:*)",

      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(du:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(jq:*)",
      "Bash(tr:*)",
      "Bash(xargs:*)",
      "Bash(tee:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(chmod +x:*)",
      "Bash(python3:*)",
      "Bash(date:*)",
      "Bash(sleep:*)",

      "Read(//Users/hamachan/UnityApp/**)",
      "Read(//private/tmp/claude-501/**)",
      "Read(//tmp/**)",

      "Skill(gipoker-verify)",
      "Skill(dev-loop)",
      "Skill(styly-netsync-helper)",
      "Skill(unity-log-analyzer)",
      "Skill(urp-shader-validator)",
      "Skill(uloop-clear-console)",
      "Skill(uloop-compile)",
      "Skill(uloop-control-play-mode)",
      "Skill(uloop-execute-dynamic-code)",
      "Skill(uloop-find-game-objects)",
      "Skill(uloop-focus-window)",
      "Skill(uloop-get-hierarchy)",
      "Skill(uloop-get-logs)",
      "Skill(uloop-launch)",
      "Skill(uloop-record-input)",
      "Skill(uloop-replay-input)",
      "Skill(uloop-run-tests)",
      "Skill(uloop-screenshot)",
      "Skill(uloop-simulate-keyboard)",
      "Skill(uloop-simulate-mouse-input)",
      "Skill(uloop-simulate-mouse-ui)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py"
          }
        ]
      }
    ]
  }
}
